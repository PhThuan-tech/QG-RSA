# Python caches and test state
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local environments and editor files
.venv/
venv/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Notebook-generated state
.ipynb_checkpoints/

# Datasets and downloaded model assets
datasets/
data/datasets/
*.pt
*.pth
*.pkl
*.safetensors
*.bin

# Runtime outputs
ckpt/
logs/
outputs/
runs/
artifacts/
cache/

# Rebuildable packages and generated reports
dist/
reports/generated/
reports/qbridge_v1_1/

# Temporary files
*.tmp
*.temp
*.log.tmp

# Measured diagnostic results are kept with the configs that produced them
!exps/diagnostics/results/*/logs/

# Measured noise/upper-bound runs (paired baselines for later candidates)
!exps/measurement/results/logs/

# Duplicates waiting for manual deletion
_duplicates_to_delete/

# Per-task diagnostics (npz/json) stay local: summaries and .log files carry the results
exps/diagnostics/results/**/*_stats/
exps/measurement/results/**/*_stats/

# Upper-bound runs: keep logs/configs/summaries, per-task stats and consoles stay local
!exps/upper/logs/
exps/upper/**/*_stats/
exps/upper/console/

# QKSR development runs: keep logs/configs/README, per-task stats and consoles stay local
!exps/qksr_old_cur/logs/
exps/qksr_old_cur/**/*_stats/
exps/qksr_old_cur/console/
