{
  "schema": "qbridge-v1.1-design-manifest",
  "status": "not runnable without repository integration and required artifacts",
  "common_incremental_overrides": {
    "use_quantum_kernel_base": true,
    "use_quantum_kernel_inc": false,
    "qbridge": {
      "enabled": true,
      "margin_x": 0.1,
      "margin_old": 0.1,
      "lambda_cross": 0.1,
      "lambda_guard": 0.1,
      "risk_gain": 0.5,
      "cross_normalization": "mean_all_old_pairs",
      "legacy_incremental_separation": "replace",
      "old_head_grad_in_added_losses": false,
      "detach_risk": true,
      "detach_guard_anchors": true,
      "preserve_original_ssca_ca": true,
      "base_checkpoint_path": "<REQUIRED_EXISTING_BASE_CHECKPOINT>"
    }
  },
  "variants": {
    "R0": {
      "description": "Legacy QKSR old_proj separation",
      "overrides": {
        "qbridge": {
          "enabled": false
        },
        "use_quantum_kernel_inc": true,
        "q_inc_pair": "old_proj"
      }
    },
    "R1": {
      "description": "All-seen CosFace replacing new-class CosFace; alignment retained; no legacy separation",
      "overrides": {
        "qbridge": {
          "variant": "R1",
          "classification_mode": "all_seen_cosface",
          "lambda_cross": 0.0,
          "lambda_guard": 0.0,
          "risk_gain": 0.0
        }
      }
    },
    "R2": {
      "description": "Uniform cross-task margin, guard off",
      "overrides": {
        "qbridge": {
          "variant": "R2",
          "risk_mode": "uniform",
          "risk_gain": 0.0,
          "lambda_guard": 0.0
        }
      }
    },
    "R3": {
      "description": "Uniform cross-task margin plus old-anchor guard",
      "overrides": {
        "qbridge": {
          "variant": "R3",
          "risk_mode": "uniform",
          "risk_gain": 0.0
        }
      }
    },
    "R4": {
      "description": "Cosine risk weighting",
      "overrides": {
        "qbridge": {
          "variant": "R4",
          "risk_mode": "cosine"
        }
      }
    },
    "R5": {
      "description": "Raw PQK weighting (full MVP)",
      "overrides": {
        "qbridge": {
          "variant": "R5",
          "risk_mode": "raw_pqk"
        }
      }
    },
    "R6": {
      "description": "Monotone calibrated PQK weighting (full v1)",
      "overrides": {
        "qbridge": {
          "variant": "R6",
          "risk_mode": "calibrated_pqk",
          "calibration": {
            "enabled": true,
            "strict_require_fitted": true
          },
          "calibrator_artifact_path": "<REQUIRED_BASE_CALIBRATOR_ARTIFACT>"
        }
      }
    },
    "R7": {
      "description": "Projected-RBF classical risk",
      "overrides": {
        "qbridge": {
          "variant": "R7",
          "risk_mode": "rbf_proj",
          "selector_artifact_path": "<REQUIRED_CLASSICAL_METRIC_ARTIFACT>"
        }
      }
    },
    "R8": {
      "description": "MLP classical risk",
      "overrides": {
        "qbridge": {
          "variant": "R8",
          "risk_mode": "mlp",
          "selector_artifact_path": "<REQUIRED_CLASSICAL_METRIC_ARTIFACT>"
        }
      }
    },
    "R9": {
      "description": "Active-pair shuffled raw PQK risk",
      "overrides": {
        "qbridge": {
          "variant": "R9",
          "risk_mode": "shuffled_raw_pqk"
        }
      }
    },
    "R10": {
      "description": "Active-pair mean constant raw PQK risk",
      "overrides": {
        "qbridge": {
          "variant": "R10",
          "risk_mode": "constant_raw_pqk"
        }
      }
    }
  }
}
